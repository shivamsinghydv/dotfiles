" ============================================================================
" ~/.vimrc — "Phosphor" theme + Apple Terminal Presets + Auto-pairs
" ============================================================================

" ----------------------------------------------------------------------------
" Core behavior
" ----------------------------------------------------------------------------
set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set number relativenumber
set cursorline
set scrolloff=6
set sidescrolloff=8
set wrap linebreak
set showmatch
set matchtime=2
set noerrorbells visualbell t_vb=
set belloff=all
set updatetime=300
set signcolumn=yes
set laststatus=2
set showcmd
set noshowmode          " custom statusline shows mode instead
set title

" Indentation
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4
set smartindent
set autoindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase
if has('nvim')
  set inccommand=nosplit
endif

" Splits & buffers
set splitright
set splitbelow
set hidden

" Completion / wildmenu
set wildmenu
set wildmode=longest:full,full
set wildignore+=*.o,*.pyc,*.class,*/.git/*,*/node_modules/*

" Persistent undo
if has('persistent_undo')
  silent !mkdir -p ~/.vim/undodir > /dev/null 2>&1
  set undodir=~/.vim/undodir
  set undofile
endif

" Color depth
if has('termguicolors')
  set termguicolors
endif
set t_Co=256

" ----------------------------------------------------------------------------
" Auto-close Brackets & Quotes
" ----------------------------------------------------------------------------
inoremap ( ()<Left>
inoremap [ []<Left>
inoremap { {}<Left>
inoremap {<CR> {<CR>}<Esc>O
inoremap " ""<Left>
inoremap ' ''<Left>
inoremap ` ``<Left>

" ----------------------------------------------------------------------------
" COLOR PALETTES & THEME SWITCHER
" ----------------------------------------------------------------------------
set background=dark

" 1. Phosphor (Original Retro CRT)
let g:theme_phosphor = {
      \ 'bg':        ['#1C1810', 234],
      \ 'bg_alt':     ['#262019', 235],
