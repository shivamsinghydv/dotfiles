function! s:Hi(group, fg, bg, attr)
  let l:cmd = 'hi ' . a:group
  if !empty(a:fg)
    let l:cmd .= ' guifg=' . a:fg[0] . ' ctermfg=' . a:fg[1]
  else
    let l:cmd .= ' guifg=NONE ctermfg=NONE'
  endif
  if !empty(a:bg)
    let l:cmd .= ' guibg=' . a:bg[0] . ' ctermbg=' . a:bg[1]
  else
    let l:cmd .= ' guibg=NONE ctermbg=NONE'
  endif
  if !empty(a:attr)
    let l:cmd .= ' gui=' . a:attr . ' cterm=' . a:attr
  endif
  execute l:cmd
endfunction

function! ApplyTheme(palette) abort
  hi clear
  if exists('syntax_on')
    syntax reset
  endif

  let s:p = a:palette

  call s:Hi('Normal',        s:p.fg,         s:p.bg,        '')
  call s:Hi('NonText',       s:p.linenr,     s:p.bg,        '')
  call s:Hi('EndOfBuffer',   s:p.linenr,     s:p.bg,        '')
  call s:Hi('CursorLine',    [],             s:p.bg_alt,    'NONE')
  call s:Hi('CursorLineNr',  s:p.linenr_cur, s:p.bg_alt,    'bold')
  call s:Hi('LineNr',        s:p.linenr,     s:p.bg,        '')
  call s:Hi('SignColumn',    s:p.linenr,     s:p.bg,        '')
  call s:Hi('Visual',        [],             s:p.bg_select, '')
  call s:Hi('Search',        s:p.bg,         s:p.amber,     'bold')
  call s:Hi('IncSearch',     s:p.bg,         s:p.orange,    'bold')
  call s:Hi('MatchParen',    s:p.bg,         s:p.amber,     'bold')
  call s:Hi('Pmenu',         s:p.fg,         s:p.bg_alt,    '')
  call s:Hi('PmenuSel',      s:p.bg,         s:p.amber,     'bold')
  call s:Hi('PmenuSbar',     [],             s:p.bg_alt,    '')
  call s:Hi('PmenuThumb',    [],             s:p.amber,     '')
  call s:Hi('VertSplit',     s:p.bg_alt,     s:p.bg,        '')
  call s:Hi('WinSeparator',  s:p.bg_alt,     s:p.bg,        '')
  call s:Hi('ColorColumn',   [],             s:p.bg_alt,    '')
  call s:Hi('Directory',     s:p.cyan,       [],            '')
  call s:Hi('Title',         s:p.amber,      [],            'bold')
  call s:Hi('ErrorMsg',      s:p.red,        s:p.bg,        'bold')
  call s:Hi('WarningMsg',    s:p.orange,     [],            '')
  call s:Hi('ModeMsg',       s:p.green,      [],            '')
  call s:Hi('Question',      s:p.green,      [],            '')

  " Syntax groups
  call s:Hi('Comment',       s:p.comment,    [],            'italic')
  call s:Hi('Constant',      s:p.orange,     [],            '')
  call s:Hi('Number',        s:p.orange,     [],            '')
  call s:Hi('Boolean',       s:p.orange,     [],            'bold')
  call s:Hi('String',        s:p.green,      [],            '')
  call s:Hi('Character',     s:p.green,      [],            '')
  call s:Hi('Identifier',    s:p.fg,         [],            '')
  call s:Hi('Function',      s:p.cyan,       [],            'bold')
  call s:Hi('Statement',     s:p.amber,      [],            'bold')
  call s:Hi('Conditional',   s:p.amber,      [],            'bold')
  call s:Hi('Repeat',        s:p.amber,      [],            'bold')
  call s:Hi('Label',         s:p.amber,      [],            '')
  call s:Hi('Operator',      s:p.fg,         [],            '')
  call s:Hi('Keyword',       s:p.amber,      [],            'bold')
  call s:Hi('Exception',     s:p.red,        [],            'bold')
  call s:Hi('PreProc',       s:p.purple,     [],            '')
  call s:Hi('Include',       s:p.purple,     [],            '')
  call s:Hi('Define',        s:p.purple,     [],            '')
  call s:Hi('Macro',         s:p.purple,     [],            '')
  call s:Hi('Type',          s:p.purple,     [],            'bold')
  call s:Hi('StorageClass',  s:p.purple,     [],            '')
  call s:Hi('Structure',     s:p.purple,     [],            '')
  call s:Hi('Typedef',       s:p.purple,     [],            '')
  call s:Hi('Special',       s:p.orange,     [],            '')
  call s:Hi('SpecialChar',   s:p.orange,     [],            '')
  call s:Hi('Delimiter',     s:p.fg_dim,     [],            '')
  call s:Hi('Underlined',    s:p.cyan,       [],            'underline')
  call s:Hi('Todo',          s:p.bg,         s:p.amber,     'bold')
  call s:Hi('DiffAdd',       s:p.green,      s:p.bg_alt,    '')
  call s:Hi('DiffChange',    s:p.amber,      s:p.bg_alt,    '')
  call s:Hi('DiffDelete',    s:p.red,        s:p.bg_alt,    '')
  call s:Hi('DiffText',      s:p.cyan,       s:p.bg_alt,    'bold')
  call s:Hi('SpellBad',      s:p.red,        [],            'underline')
  call s:Hi('SpellCap',      s:p.cyan,       [],            'underline')

  " Update Dynamic Statusline Highlights
  execute 'hi StatusMode guifg=' . s:p.bg[0] . ' guibg=' . s:p.amber[0] . ' ctermfg=' . s:p.bg[1] . ' ctermbg=' . s:p.amber[1] . ' gui=bold cterm=bold'
  execute 'hi StatusFile guifg=' . s:p.fg[0] . ' guibg=' . s:p.bg_alt[0] . ' ctermfg=' . s:p.fg[1] . ' ctermbg=' . s:p.bg_alt[1]
  execute 'hi StatusGit  guifg=' . s:p.green[0] . ' guibg=' . s:p.bg_alt[0] . ' ctermfg=' . s:p.green[1] . ' ctermbg=' . s:p.bg_alt[1]
  execute 'hi StatusInfo guifg=' . s:p.cyan[0] . ' guibg=' . s:p.bg_alt[0] . ' ctermfg=' . s:p.cyan[1] . ' ctermbg=' . s:p.bg_alt[1]
endfunction

" Command to switch themes easily
command! -nargs=1 -complete=customlist,ThemeComplete SetTheme call SwitchTheme(<f-args>)

function! SwitchTheme(name) abort
  let l:key = 'g:theme_' . a:name
  if exists(l:key)
    call ApplyTheme(eval(l:key))
  else
    echoerr "Unknown theme: " . a:name
  endif
endfunction

function! ThemeComplete(ArgLead, L, P) abort
  return filter(['phosphor', 'apple_basic', 'apple_homebrew', 'apple_ocean'], 'v:val =~ "^" . a:ArgLead')
endfunction

" Set default active theme
call ApplyTheme(g:theme_phosphor)

" ----------------------------------------------------------------------------
" Custom statusline — mode + file + git branch + filetype + position
" ----------------------------------------------------------------------------
function! PhosphorMode() abort
  let l:m = mode()
  let l:map = {
        \ 'n':      'NORMAL', 'i': 'INSERT', 'v': 'VISUAL', 'V': 'V-LINE',
        \ "\<C-v>": 'V-BLOCK', 'R': 'REPLACE', 'c': 'COMMAND', 't': 'TERMINAL' }
  return get(l:map, l:m, l:m)
endfunction

let b:phosphor_git_branch = ''

function! PhosphorRefreshGitBranch() abort
  if exists('*FugitiveHead')
    let b:phosphor_git_branch = FugitiveHead()
    return
  endif
  let l:branch = system('git -C ' . shellescape(expand('%:p:h')) . ' rev-parse --abbrev-ref HEAD 2>/dev/null')
  let b:phosphor_git_branch = v:shell_error ? '' : substitute(l:branch, '\n', '', '')
endfunction

function! PhosphorGitBranch() abort
  return get(b:, 'phosphor_git_branch', '')
endfunction

augroup PhosphorGit
  autocmd!
  autocmd BufEnter,BufWritePost,DirChanged * call PhosphorRefreshGitBranch()
augroup END

set statusline=
set statusline+=%#StatusMode#\ %{PhosphorMode()}\ 
set statusline+=%#StatusFile#\ %f\ %m%r
set statusline+=%#StatusGit#\ %{PhosphorGitBranch()!=''?'\ ⎇\ '.PhosphorGitBranch().'\ ':''}
set statusline+=%=
set statusline+=%#StatusInfo#\ %y\ %{&fileencoding?&fileencoding:&encoding}\ 
set statusline+=%#StatusMode#\ %l:%c\ %p%%\ 

" ----------------------------------------------------------------------------
" Interactive niceties
" ----------------------------------------------------------------------------
if &term =~ '^xterm\|tmux\|screen'
  let &t_SI = "\<Esc>[6 q"   " insert: thin bar
  let &t_SR = "\<Esc>[4 q"   " replace: underline
  let &t_EI = "\<Esc>[2 q"   " normal: block
endif

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_winsize = 25

" ----------------------------------------------------------------------------
" Keymaps
" ----------------------------------------------------------------------------
let mapleader = ' '

nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>Q :qa!<CR>

nnoremap <leader><Esc> :nohlsearch<CR>

nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <leader>sv :vsplit<CR>
nnoremap <leader>sh :split<CR>

nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprevious<CR>
nnoremap <leader>bd :bdelete<CR>

nnoremap <leader>e :Lexplore<CR>

vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

nnoremap <leader>rn :set relativenumber!<CR>

nnoremap <leader>ve :edit $MYVIMRC<CR>
nnoremap <leader>vr :source $MYVIMRC<CR>
