      \ 'fg':         ['#FFFFFF', 15],
      \ 'fg_dim':      ['#99B3FF', 111],
      \ 'comment':    ['#668CFF', 69],
      \ 'amber':      ['#FFCC66', 221],
      \ 'green':      ['#66FFB3', 85],
      \ 'cyan':       ['#66FFFF', 87],
      \ 'orange':     ['#FF9966', 209],
      \ 'red':        ['#FF6666', 203],
